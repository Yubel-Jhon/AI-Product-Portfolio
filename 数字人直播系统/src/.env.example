# 把 DeepSeek 的 key 填进来，然后把本文件重命名为 .env
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 可选：换音色（zh-CN-XiaoxiaoNeural 女声 / zh-CN-YunxiNeural 男声 等）
TTS_VOICE=zh-CN-XiaoxiaoNeural

# AutoDL 实例连接信息（remote.py / upload.py 会读，需填真实值）
AUTODL_HOST=connect.nmb2.seetacloud.com
AUTODL_PORT=38427
AUTODL_USER=root
AUTODL_PWD=xxxxxxxxxxxxxxxx
